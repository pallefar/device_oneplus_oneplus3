// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  ADMIN
  LEADER
  AGENT
}

enum AssessmentStatus {
  PENDING
  SELF_COMPLETED
  MANAGER_COMPLETED
  FINALIZED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(AGENT)
  department String?
  avatarUrl String?  // Profile picture
  bio       String?  // User bio
  timezone  String?  // User timezone for calendar
  language  String   @default("en") // Preferred language
  experiencePoints Int @default(0) // Gamification XP
  level     Int      @default(1)    // Gamification level
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  createdFrameworks     CareerFramework[]
  createdAssessments    Assessment[]
  agentAssignments      AssessmentAssignment[] @relation("AgentAssignments")
  managerAssignments    AssessmentAssignment[] @relation("ManagerAssignments")
  skillMatrix           SkillMatrix[]
  achievements          UserAchievement[]
  badges                UserBadge[]
  givenEndorsements     SkillEndorsement[] @relation("EndorsementGiver")
  receivedEndorsements  SkillEndorsement[] @relation("EndorsementReceiver")
  aiConversations       AIConversation[]
  learningGoals         LearningGoal[]
  calendarEvents        CalendarEvent[]
}

model CareerFramework {
  id          String   @id @default(cuid())
  name        String
  description String?
  version     String   @default("1.0")
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdBy     User          @relation(fields: [createdById], references: [id])
  levels        Level[]
  competencies  Competency[]
  assessments   Assessment[]
}

model Level {
  id          String @id @default(cuid())
  frameworkId String
  name        String
  description String?
  order       Int

  // Relations
  framework CareerFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  skills    Skill[]
}

model Competency {
  id          String @id @default(cuid())
  frameworkId String
  name        String
  description String?

  // Relations
  framework CareerFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  skills    Skill[]
}

model Skill {
  id            String  @id @default(cuid())
  competencyId  String
  levelId       String
  name          String
  description   String?

  // Relations
  competency          Competency             @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  level               Level                  @relation(fields: [levelId], references: [id], onDelete: Cascade)
  assessmentResponses AssessmentResponse[]
  skillMatrix         SkillMatrix[]
  endorsements        SkillEndorsement[]
}

model Assessment {
  id          String           @id @default(cuid())
  frameworkId String
  name        String
  description String?
  dueDate     DateTime?
  status      AssessmentStatus @default(PENDING)
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  framework   CareerFramework        @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  createdBy   User                   @relation(fields: [createdById], references: [id])
  assignments AssessmentAssignment[]
}

model AssessmentAssignment {
  id                  String           @id @default(cuid())
  assessmentId        String
  agentId             String
  managerId           String
  status              AssessmentStatus @default(PENDING)
  selfCompletedAt     DateTime?
  managerCompletedAt  DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // Relations
  assessment Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  agent      User                   @relation("AgentAssignments", fields: [agentId], references: [id])
  manager    User                   @relation("ManagerAssignments", fields: [managerId], references: [id])
  responses  AssessmentResponse[]
}

model AssessmentResponse {
  id             String  @id @default(cuid())
  assignmentId   String
  skillId        String
  selfRating     Int?
  managerRating  Int?
  selfComments   String?
  managerComments String?

  // Relations
  assignment AssessmentAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  skill      Skill                @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, skillId])
}

model SkillMatrix {
  id             String   @id @default(cuid())
  userId         String
  skillId        String
  currentLevel   Int      @default(0)
  targetLevel    Int?
  lastAssessedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model AppDownload {
  id           String   @id @default(cuid())
  downloadedBy String?  // User ID if logged in
  ipAddress    String?
  userAgent    String?
  downloadedAt DateTime @default(now())
}

model AppUsage {
  id        String   @id @default(cuid())
  userId    String?
  ipAddress String?
  action    String   // "login", "framework_created", "assessment_created", etc.
  metadata  String?  // JSON string for additional data
  timestamp DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "assessment_assigned", "assessment_completed", "assessment_finalized", "milestone", etc.
  title     String
  message   String
  link      String?  // Optional link to related resource
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============================================
// VISION 2030 FEATURES
// ============================================

// System Settings for API keys and configuration
model SystemSettings {
  id              String   @id @default(cuid())
  key             String   @unique // e.g., "openai_api_key", "ms_copilot_key"
  value           String?  // Encrypted value
  description     String?
  category        String   // "ai", "integrations", "features", "security"
  isSecret        Boolean  @default(false) // If true, value is encrypted
  updatedAt       DateTime @updatedAt
  updatedBy       String?  // User ID who last updated
}

// Gamification: Achievements
model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique // e.g., "first_assessment", "skill_master"
  name        String
  description String
  icon        String   // Emoji or icon name
  category    String   // "assessment", "learning", "social", "milestone"
  xpReward    Int      @default(0)
  condition   String?  // JSON describing unlock condition
  tier        String   @default("bronze") // bronze, silver, gold, platinum
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relations
  userAchievements UserAchievement[]
}

// User's earned achievements
model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())
  progress      Int      @default(100) // Percentage for partial achievements

  // Relations
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

// Gamification: Badges
model Badge {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  icon        String   // Emoji or icon name
  color       String   // Hex color
  rarity      String   @default("common") // common, rare, epic, legendary
  requirement String?  // How to earn this badge
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relations
  userBadges UserBadge[]
}

// User's earned badges
model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())
  isPinned  Boolean  @default(false) // User can pin favorite badges

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

// Peer skill endorsements
model SkillEndorsement {
  id              String   @id @default(cuid())
  skillId         String
  endorserId      String   // User giving endorsement
  endorseeId      String   // User receiving endorsement
  comment         String?
  relationshipType String? // "colleague", "manager", "mentor", "direct_report"
  createdAt       DateTime @default(now())

  // Relations
  skill     Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  endorser  User  @relation("EndorsementGiver", fields: [endorserId], references: [id])
  endorsee  User  @relation("EndorsementReceiver", fields: [endorseeId], references: [id])

  @@unique([skillId, endorserId, endorseeId])
}

// AI Career Coach conversations
model AIConversation {
  id            String   @id @default(cuid())
  userId        String
  provider      String   @default("openai") // "openai", "copilot", "claude"
  conversationId String? // External conversation ID
  messages      String   // JSON array of messages
  context       String?  // JSON of conversation context
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Learning goals
model LearningGoal {
  id          String    @id @default(cuid())
  userId      String
  skillId     String?   // Optional: linked to specific skill
  title       String
  description String?
  targetDate  DateTime?
  status      String    @default("active") // "active", "completed", "abandoned"
  progress    Int       @default(0) // 0-100
  priority    Int       @default(5) // 1-10
  milestones  String?   // JSON array of milestones
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Calendar events for learning time
model CalendarEvent {
  id            String    @id @default(cuid())
  userId        String
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  eventType     String    @default("learning") // "learning", "assessment", "meeting", "goal"
  location      String?
  isAllDay      Boolean   @default(false)
  isRecurring   Boolean   @default(false)
  recurrenceRule String?  // iCal RRULE format
  externalId    String?   // Google Calendar, Outlook ID
  provider      String?   // "google", "outlook", "apple"
  metadata      String?   // JSON for additional data
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Market intelligence cache
model MarketIntelligence {
  id          String   @id @default(cuid())
  dataType    String   // "skill_demand", "salary_data", "job_postings"
  skillName   String?
  location    String?
  industry    String?
  dataPoint   String   // JSON of the data
  source      String   // "linkedin", "indeed", "glassdoor"
  validUntil  DateTime // Cache expiration
  createdAt   DateTime @default(now())

  @@index([skillName, dataType])
}

// Skill trends over time
model SkillTrend {
  id              String   @id @default(cuid())
  skillName       String
  demandScore     Float    // 0-100 demand index
  salaryPremium   Float?   // Average salary increase
  growthRate      Float?   // Month-over-month growth %
  jobPostings     Int?     // Number of job postings
  location        String?
  capturedAt      DateTime @default(now())

  @@index([skillName, capturedAt])
}

// XP transactions for gamification
model XPTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int      // Can be positive or negative
  reason      String
  category    String   // "assessment", "learning", "social", "achievement"
  metadata    String?  // JSON with details
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// Social recognition/kudos
model Kudos {
  id          String   @id @default(cuid())
  fromUserId  String
  toUserId    String
  skillId     String?  // Optional: linked to skill
  message     String
  type        String   @default("general") // "general", "skill", "project", "mentorship"
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([toUserId, createdAt])
}

// Succession planning
model SuccessionPlan {
  id              String   @id @default(cuid())
  targetRole      String   // Role being planned for
  candidateIds    String   // JSON array of user IDs
  notes           String?  // Admin notes about the plan
  timelineMonths  Int      // Expected timeline in months
  status          String   @default("active") // "active", "completed", "cancelled"
  createdBy       String   // Admin who created the plan
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([targetRole, status])
}

// Skills-based compensation
model CompensationBenchmark {
  id              String   @id @default(cuid())
  skillName       String
  competency      String?  // Competency category
  level           Int?     // Skill level (1-5)
  baseValue       Float    // Market value in USD
  premiumPercent  Float    // Premium percentage (0-100)
  marketDemand    Float    // Demand score (0-100)
  location        String?  // Geographic location
  industry        String?  // Industry vertical
  source          String   // "linkedin", "glassdoor", "indeed", "payscale"
  sampleSize      Int      @default(1) // Number of data points
  lastUpdated     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([skillName, level])
  @@index([competency])
}

// Skill value analytics (aggregated, no individual salaries)
model SkillValueAnalytics {
  id                String   @id @default(cuid())
  skillName         String
  avgMarketValue    Float    // Average market value
  minValue          Float    // Minimum market value
  maxValue          Float    // Maximum market value
  trend             String   // "rising", "stable", "declining"
  demandIndex       Float    // 0-100
  rarityScore       Float    // 0-100 (how rare is this skill)
  usersWithSkill    Int      // Count of users with this skill
  avgSkillLevel     Float    // Average proficiency level
  topCompanies      String?  // JSON array of top companies
  relatedSkills     String?  // JSON array of related skills
  calculatedAt      DateTime @default(now())

  @@unique([skillName])
  @@index([avgMarketValue])
}

// Compensation recommendations (privacy-preserving)
model CompensationRecommendation {
  id              String   @id @default(cuid())
  userId          String
  skillSnapshot   String   // JSON of skills and levels at time of calculation
  calculatedValue Float    // Estimated total value
  marketPercentile Float   // Where user stands (0-100)
  recommendations String   // JSON array of recommendations
  potentialGain   Float    // Potential increase from skill development
  topSkillGaps    String   // JSON array of high-value missing skills
  createdAt       DateTime @default(now())
  expiresAt       DateTime // Recommendations expire after 90 days

  @@index([userId, createdAt])
}

// Multi-language translations
model Translation {
  id          String   @id @default(cuid())
  key         String   // Translation key (e.g., "dashboard.welcome")
  language    String   // Language code (en, es, fr, de, zh, etc.)
  value       String   // Translated text
  category    String?  // Category for organization (ui, emails, notifications)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, language])
  @@index([language])
  @@index([category])
}

// Career path predictions (ML-powered)
model CareerPathPrediction {
  id                String   @id @default(cuid())
  userId            String
  targetRole        String
  currentRole       String
  successProbability Float   // 0-100
  estimatedMonths   Int
  requiredSkills    String   // JSON array of skills needed
  skillGaps         String   // JSON array of missing skills with priorities
  recommendations   String   // JSON array of actionable steps
  confidenceScore   Float    // ML model confidence (0-100)
  calculatedAt      DateTime @default(now())
  expiresAt         DateTime // Predictions expire after 90 days

  @@index([userId, calculatedAt])
  @@index([targetRole])
}

// External learning platform connections
model LMSConnection {
  id              String   @id @default(cuid())
  userId          String
  platform        String   // "coursera", "udemy", "linkedin", "pluralsight"
  accessToken     String?  // Encrypted OAuth token
  refreshToken    String?  // Encrypted refresh token
  externalUserId  String?  // User ID on external platform
  isActive        Boolean  @default(true)
  lastSyncedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, platform])
  @@index([userId])
}

// Aggregated course data from LMS platforms
model ExternalCourse {
  id              String   @id @default(cuid())
  platform        String   // "coursera", "udemy", etc.
  externalId      String   // Course ID on platform
  title           String
  description     String?
  instructors     String?  // JSON array
  skillsTaught    String?  // JSON array
  duration        Int?     // Minutes
  difficulty      String?  // "beginner", "intermediate", "advanced"
  rating          Float?
  enrollmentCount Int?
  price           Float?
  currency        String   @default("USD")
  url             String
  thumbnailUrl    String?
  lastUpdated     DateTime @default(now())

  @@unique([platform, externalId])
  @@index([platform])
}

// User course enrollments across platforms
model CourseEnrollment {
  id              String   @id @default(cuid())
  userId          String
  courseId        String   // References ExternalCourse
  platform        String
  status          String   @default("enrolled") // "enrolled", "in_progress", "completed"
  progress        Int      @default(0) // 0-100
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  certificateUrl  String?
  lastAccessedAt  DateTime?

  @@index([userId, status])
  @@index([courseId])
}

// Learning style preferences
model LearningPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  primaryStyle    String   // "visual", "auditory", "kinesthetic", "reading"
  pace            String   @default("normal") // "slow", "normal", "fast"
  sessionLength   Int      @default(30) // Preferred minutes per session
  timeOfDay       String?  // "morning", "afternoon", "evening"
  includeVideo    Boolean  @default(true)
  includeText     Boolean  @default(true)
  includeAudio    Boolean  @default(false)
  includeInteractive Boolean @default(true)
  neurodiversity  String?  // "adhd", "dyslexia", "autism", etc.
  updatedAt       DateTime @updatedAt
}

// Study groups / learning communities
model StudyGroup {
  id              String   @id @default(cuid())
  name            String
  description     String?
  skillFocus      String?  // Skill or topic
  meetingSchedule String?  // iCal RRULE or description
  maxMembers      Int      @default(10)
  isPublic        Boolean  @default(true)
  creatorId       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([skillFocus])
  @@index([isPublic])
}

// Study group memberships
model StudyGroupMember {
  id          String   @id @default(cuid())
  groupId     String
  userId      String
  role        String   @default("member") // "member", "moderator", "creator"
  joinedAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

// Blockchain skill credentials (Web3)
model BlockchainCredential {
  id              String   @id @default(cuid())
  userId          String
  skillName       String
  competency      String
  level           Int      // 1-5
  issuedBy        String   // Issuer name
  blockchainType  String   @default("ethereum") // "ethereum", "polygon"
  tokenId         String?  // NFT token ID
  contractAddress String?  // Smart contract address
  transactionHash String?  // Blockchain transaction hash
  metadataUri     String?  // IPFS URI for metadata
  isVerified      Boolean  @default(false)
  issuedAt        DateTime @default(now())
  expiresAt       DateTime?

  @@index([userId])
  @@index([skillName])
  @@index([transactionHash])
}
